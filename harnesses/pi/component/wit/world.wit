// Pi as a sandboxed agent, the world it builds from.
//
// Imports, all at cosmonic:agent@0.4.2: the model by alias (inference-types,
// models, chat), the conversation (session), and the tools the workload
// grants. The clock is for real timers (a wait that suspends hands control
// back to the host) and the run's deadline; random is for commit and run ids,
// which must not come from Math.random in a snapshotted (Wizer) heap.
//
// Exports: `cosmonic:agent/run@0.4.2` (unstable, feature `agent-run`), the
// typed run a host drives the agent through; `cosmonic:agent/compact@0.4.2`,
// a summary the host asks for between runs (with `run`, the
// `compactable-agent` world); and wasi:http/handler@0.3.0, which serves
// POST /task for hosts that do not call `run` yet.
//
// Every package is fetched by wkg from its registry and pinned by digest in
// wkg.lock. This package names the harness's own world. It is not an
// interface for anything else to import, and it is versioned apart from
// cosmonic:agent.
package cosmonic:pi-agent@0.4.0;

world pi-agent {
  import cosmonic:agent/inference-types@0.4.2;
  import cosmonic:agent/models@0.4.2;
  import cosmonic:agent/chat@0.4.2;
  import cosmonic:agent/session@0.4.2;
  import cosmonic:agent/tools@0.4.2;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:random/random@0.3.0;
  export wasi:http/handler@0.3.0;
  export cosmonic:agent/compact@0.4.2;
  export cosmonic:agent/run@0.4.2;
}
