pnpm := env_var_or_default("PNPM", "pnpm")
node := env_var_or_default("NODE", "node")
cargo := env_var_or_default("CARGO", "cargo")

set shell := ["bash", "-euo", "pipefail", "-c"]

scripts := justfile_directory() / "../shared/scripts"
test_host := justfile_directory() / "../shared/test-host"

@_default:
    just --list

# Build the harness and run the sandbox gate on it: dist/pi-harness.wasm.
# COMPONENTIZE_QJS must name the patched componentize-qjs (see README).
build:
    {{pnpm}} install --frozen-lockfile
    {{pnpm}} run typecheck
    {{node}} {{scripts}}/fetch-wit.mjs component deny-fs
    {{node}} build.ts
    {{node}} {{scripts}}/check-harness.mjs dist/pi-agent.wasm
    cp dist/pi-agent.wasm dist/pi-harness.wasm
    @ls -l dist/pi-harness.wasm

# Build, then the rule tests under Node and the scripted test host.
test: build test-unit test-e2e

# The rule tests alone, which need nothing beyond Node and the installed
# dependencies.
test-unit:
    {{node}} --test component/test/*.ts

# Drive the built component through the scripted test host: runs, the
# compact export and the automatic compaction.
test-e2e: build
    {{node}} {{scripts}}/fetch-wit.mjs {{test_host}}
    cd {{test_host}} && {{cargo}} run --locked -- pi "{{justfile_directory()}}/dist/pi-harness.wasm"
