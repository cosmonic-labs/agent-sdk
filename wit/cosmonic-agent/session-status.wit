package cosmonic:agent@0.4.3;

/// Where a session stands, as its host reports it.
///
/// The host owns the state and derives it only from facts it can vouch for:
/// whether a run or a compaction is in progress, whether its own gates hold
/// something for a person, and how the last run ended. Nothing an agent
/// writes or a model says sets it. A run that finishes `input-required` is
/// `done`, not `needs-input`; the person's answer starts the next run.
///
/// As with `session` and `run`, the host binds the session and the caller
/// never names one. A host gives this import to a component that drives or
/// watches an agent, such as an adapter serving a status endpoint, bound to
/// that agent's session.
///
/// Adding a case to `session-state` is a breaking change, so a host reports
/// a state this version does not name as `other` with its name until a minor
/// release adds it. A caller treats a state it does not know as unknown: it
/// may show the name but acts on nothing.
///
/// Unstable: the shape may change before it is marked `@since`.
@unstable(feature = session-status)
interface session-status {
    /// One session's state. Exactly one holds at a time: the first case, in
    /// the order listed, that applies. A run waiting on a person is
    /// `needs-input`, not `working`.
    @unstable(feature = session-status)
    variant session-state {
        /// The host holds something at one of its gates for a person, such as
        /// a tool call or outbound request awaiting approval, a tool awaiting
        /// addition, or a change awaiting review. Applies whether or not a run
        /// is in progress.
        needs-input,
        /// A run or a compaction is in progress.
        working,
        /// The last run ended with an error other than `cancelled`, or was cut
        /// off because the host stopped or restarted. A cancelled run leaves
        /// the session `idle`.
        failed,
        /// The last run ended with a reply, whatever its finish (`done`,
        /// `input-required`, a limit, `refusal` or `content-filter`).
        done,
        /// No run has ended since the session began or was cleared, or the
        /// last run was cancelled.
        idle,
        /// A state this version does not name, given by its kebab-case name.
        other(string),
    }

    /// A session's state, when it began, and the run it concerns.
    @unstable(feature = session-status)
    record status {
        state: session-state,
        /// When the session entered this state, in milliseconds since the
        /// Unix epoch. For `needs-input`, when the oldest held item was
        /// raised. `none` when the host does not know, such as a session that
        /// has never run.
        since-ms: option<u64>,
        /// The `run-id` its driver gave the run this state concerns: the run
        /// in progress for `working` and `needs-input`, the last run for
        /// `done` and `failed`. `none` otherwise, including during a
        /// compaction, which may reuse a run's id.
        run: option<string>,
    }

    /// Why the host could not report the state.
    @unstable(feature = session-status)
    variant status-error {
        /// The host could not serve the call; the detail is for logs.
        unavailable(string),
        other(string),
    }

    /// The session's status now.
    @unstable(feature = session-status)
    get: async func() -> result<status, status-error>;

    /// The current status, then each change in order. A slow reader may miss
    /// a short-lived state but never sees an older status after a newer one.
    /// Drop the stream to stop watching; it ends when the session does.
    @unstable(feature = session-status)
    watch: async func() -> result<stream<status>, status-error>;
}
