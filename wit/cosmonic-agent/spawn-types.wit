package cosmonic:agent@0.4.4;

/// Types shared by `session-tree` and `spawn`. No functions:
/// importing it grants nothing. Unstable behind `agent-spawn`, which also
/// needs `agent-tool-loading`, `agent-run` and `agent-session-status`, whose
/// types these use.
///
/// Sessions spawned from one root session form a session tree. A child's
/// reach never exceeds what its ancestors hold plus what a grantor approved
/// for that child, and is checked again each time the child starts a run or
/// loads a tool component, and whenever what it rests on narrows. Budgets
/// cover a session and everything below it.
///
/// What a caller sees of a child is the implementer's own (state, usage,
/// model, progress) except for what the child produced in an outcome: the
/// reply, the structured value and the `finish` it reported. Those are the
/// child's, can carry anything the child read, and authorize nothing; a
/// structured value that matches its schema is still untrusted content.
/// Nothing here blocks prompt injection. Records about sessions below the
/// caller's direct children carry no text a child chose. A child can still
/// signal through how much it spends and when, and through tree-wide limits,
/// as seen in usage, remaining budgets, `over-limit` answers and
/// `watch-children` events.
///
/// Session ids and run ids authorize nothing on their own: the implementer
/// acts only for the component that spawned a child.
@unstable(feature = agent-spawn)
interface spawn-types {
    @unstable(feature = agent-spawn)
    use wasi:clocks/types@0.3.0.{duration};
    @unstable(feature = agent-spawn)
    use run-types.{run-outcome, run-counts};
    @unstable(feature = agent-spawn)
    use session-status-types.{session-status};
    @unstable(feature = agent-spawn)
    use tool-component-types.{pending-approval};

    /// A session's id, assigned by the implementer.
    @unstable(feature = agent-spawn)
    type session-id = string;

    /// A run's id within its child. The caller chooses it: 1 to 64
    /// characters of `[a-z0-9-]`, never reused. It is the `run-id` the
    /// child's run gets, so the child's `session-status` shows it.
    @unstable(feature = agent-spawn)
    type run-id = string;

    /// A budget that can leave a session unable to take another run.
    @unstable(feature = agent-spawn)
    variant session-budget-item {
        /// The session's `max-runs`.
        max-runs,
        /// Tokens, the session's or an ancestor's.
        max-total-tokens,
        /// Time: an ancestor's active time, which halts the session, or the
        /// session's own `max-duration`, which ends it.
        max-duration,
        /// A budget this version does not name, by its kebab-case name.
        /// Treat it as spent until someone raises it.
        other(string),
    }

    /// Why a child takes no more runs, or why it ended. Detail strings are
    /// diagnostic: the implementer's own words, never the child's.
    @unstable(feature = agent-spawn)
    variant stop-reason {
        /// A grantor refused it.
        denied(option<string>),
        /// Its approval request was withdrawn (the caller ended it) or
        /// expired undecided.
        withdrawn,
        /// Its components could not start.
        start-failed(option<string>),
        /// A budget is spent, until an operator or person raises it. A
        /// child's own `max-duration` ends it instead.
        exhausted(session-budget-item),
        /// It no longer fits its ancestors' current reach or policy.
        revoked(option<string>),
        /// A reason not captured above.
        other(option<string>),
    }

    /// Where a child stands.
    @unstable(feature = agent-spawn)
    variant child-state {
        /// Waiting on a grantor. Holds no instance and no reach; runs sent
        /// to it wait too. Below the caller's direct children the summary is
        /// empty.
        pending(pending-approval),
        /// Admitted, with its session status: what is in progress, whether
        /// it holds something for a person, and how its last run ended,
        /// whoever started that run. A `finish` the child reported as
        /// `other` carries an empty string here, so the status carries no
        /// text a child chose. Below the caller's direct children, the run
        /// ids in `activity.running` and `last-run.run` are `none` too.
        live(session-status),
        /// Admitted, but takes no more runs, for this reason. It keeps its
        /// conversation. Only `exhausted` lifts, when the budget is raised.
        halted(stop-reason),
        /// Ended; the reason, when it was not an orderly `end`. A refused or
        /// withdrawn pending child ends this way, freeing its place.
        ended(option<stop-reason>),
        /// A state this version does not name, by its kebab-case name.
        /// Treat the child as taking no runs now, and read it again later.
        other(string),
    }

    /// Why a child's run failed after it was accepted. Detail strings are
    /// diagnostic: the implementer's own words, never the child's.
    @unstable(feature = agent-spawn)
    variant child-run-error {
        /// Cancelled, at whatever phase it had reached. Effects caused
        /// before the child stopped remain.
        cancelled,
        /// The outcome broke the output shape or size limit. The detail never
        /// quotes the rejected output.
        output-rejected(option<string>),
        /// The child was never admitted (refused, withdrawn or expired), so
        /// the run never started.
        not-admitted,
        /// A person or auditor declined to release the outcome.
        withheld,
        /// The machine running the child stopped or was lost before `run`
        /// returned the run's outcome; the child's `last-run` shows
        /// `interrupted` too.
        /// Effects already under way may remain; a later run starts afresh
        /// from the recorded conversation.
        interrupted(option<string>),
        /// Stopped because the child no longer fits its ancestors' current
        /// reach or policy.
        revoked,
        /// The child failed.
        failed(option<string>),
        /// The run ended and its outcome is no longer kept.
        expired,
        /// A failure not captured above.
        other(option<string>),
    }

    /// How a run the caller started in a child stands.
    @unstable(feature = agent-spawn)
    variant run-state {
        /// Accepted and not yet ended.
        in-progress,
        /// Ended with an outcome.
        done,
        /// Ended without one.
        failed(child-run-error),
        /// A state this version does not name, by its kebab-case name. Treat
        /// the run as not yet ended: `wait` resolves it.
        other(string),
    }

    /// The last run the caller started in a child.
    @unstable(feature = agent-spawn)
    record sent-run {
        /// The run's id.
        run-id: run-id,
        /// How it stands as the caller sees it.
        state: run-state,
    }

    /// Spend the implementer metered for a session and its whole subtree.
    @unstable(feature = agent-spawn)
    record session-usage-total {
        /// Prompt plus completion tokens.
        tokens: u64,
        /// Runs accepted across the subtree.
        runs: u32,
        /// Model calls made.
        model-calls: u32,
    }

    /// One session in the caller's subtree.
    @unstable(feature = agent-spawn)
    record session-info {
        /// The name the caller gave it; set for the caller's direct children
        /// only, since deeper names were written by a child.
        name: option<string>,
        /// Its session id, for drawing the tree.
        session-id: session-id,
        /// Its parent's session id.
        parent: session-id,
        /// How far below its root it sits: 1 for a root's child.
        depth: u32,
        /// Where it stands.
        state: child-state,
        /// The last run the caller started there and how it stands as the
        /// caller sees it, including endings only the caller sees, such as
        /// `withheld`, `not-admitted` and `expired`. `none` for deeper
        /// descendants and for a child the caller never sent to. The child's
        /// own last ended run, whoever started it, is `last-run` in its
        /// `live` status.
        sent-run: option<sent-run>,
        /// An operator-named host group or zone it last ran in, for display.
        location: option<string>,
        /// What it and its subtree have spent.
        usage: session-usage-total,
    }

    /// What the caller has left. Its own figures are exact. Ancestor figures
    /// are coarse (rounded down to a power of two tokens or a whole minute,
    /// refreshed at most once a minute). That narrows what one subtree can
    /// learn of another's spending but does not close it: a change in a
    /// coarse figure still says that something below the ancestor spent.
    @unstable(feature = agent-spawn)
    record remaining-spawn-budget {
        /// Tokens left under its own budget; none if it sets no limit.
        tokens: option<u64>,
        /// Time left under its own limit, on that limit's clock (since
        /// admission for a child, active time for a root); none if no limit.
        duration: option<duration>,
        /// Runs left under its own `max-runs`; none if no limit.
        runs: option<u32>,
        /// The tightest ancestor's tokens left, coarse. Always set, since
        /// every root is finite; for a root it is its own budget, coarse.
        ancestor-tokens: u64,
        /// The tightest ancestor's time left, coarse; for a root, its own.
        ancestor-duration: duration,
    }

    /// Why a run is paused.
    @unstable(feature = agent-spawn)
    variant run-blocked-reason {
        /// The child is waiting on a grantor before its first run.
        admission,
        /// A tool call or load waits on a person or auditor. When a person
        /// is asked, this is the same condition that sets `needs-input` in
        /// the child's `live` status, seen at run level.
        tool-approval,
        /// Policy holds the outcome for release.
        outcome-release,
        /// The run waits to be placed after its machine was lost.
        placement-delay,
        /// A reason this version does not name, by its kebab-case name. Treat
        /// the run as paused.
        other(string),
    }

    /// Contentless progress, coalesced by the implementer.
    @unstable(feature = agent-spawn)
    variant run-progress {
        /// Working.
        working,
        /// Paused.
        blocked(run-blocked-reason),
        /// Cancellation was requested and the child has not stopped yet.
        cancelling,
        /// Cumulative counts for this run, metered by the implementer.
        counts(run-counts),
        /// A frame this version does not name, by its kebab-case name. Safe
        /// to ignore.
        other(string),
    }

    /// One subscription to a child's run: its progress, then its outcome.
    ///
    /// The two halves are independent. The outcome resolves when the run
    /// ends whether or not progress is read; unread progress frames are
    /// coalesced, never holding up the run or its outcome. The progress
    /// stream opens with the run's current state and ends when the run ends.
    /// Every `send`, retry or `watch-run` gets its own subscription. Dropping
    /// either half only stops listening; the run goes on, and
    /// `child-session.wait` collects it later.
    @unstable(feature = agent-spawn)
    record child-run {
        /// Contentless progress until the run ends.
        progress: stream<run-progress>,
        /// The outcome, once the run ends.
        outcome: future<result<run-outcome, child-run-error>>,
    }
}
