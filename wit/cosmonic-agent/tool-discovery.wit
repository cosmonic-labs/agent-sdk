package cosmonic:agent@0.4.4;

/// The caller may ask which tool components are available to it. Unstable
/// behind `agent-tool-loading`.
///
/// The implementer keeps the catalog and answers for this caller only,
/// leaving out offers policy would never grant. Asking starts and loads
/// nothing. The host's `find_tools` tool is an adapter over `list-offers`.
/// Tool names and descriptions are written by tool component authors: treat
/// them as untrusted input to a model.
@unstable(feature = agent-tool-loading)
interface tool-discovery {
    @unstable(feature = agent-tool-loading)
    use tool-types.{tool-def};
    @unstable(feature = agent-tool-loading)
    use tool-component-types.{tool-component-state};

    /// How an offer relates to the caller's ceiling (what it may add without
    /// asking). Describes reach; policy may still ask within the ceiling.
    @unstable(feature = agent-tool-loading)
    variant ceiling-fit {
        /// Loading it needs no grantor.
        within-ceiling,
        /// Loading it waits on a grantor, who could allow it.
        beyond-ceiling,
        /// A relation not captured above. Treat as `beyond-ceiling`.
        other(option<string>),
    }

    /// One catalog entry the caller may load or hand to a child.
    @unstable(feature = agent-tool-loading)
    record offer {
        /// The catalog name, as `catalog-entry` takes it.
        name: string,
        /// What it does, from the catalog.
        summary: string,
        /// Its tools under their own names.
        tools: list<tool-def>,
        /// The interfaces its pinned component imports, read from the
        /// binary: it can call nothing else directly. This does not show
        /// where data flows through those interfaces or their configuration.
        imports: list<string>,
        /// Fit against the caller's ceiling.
        fit: ceiling-fit,
        /// Its state in the caller's session, if the caller holds it.
        state: option<tool-component-state>,
    }

    /// Why discovery failed.
    @unstable(feature = agent-tool-loading)
    variant discovery-error {
        /// Discovery is not enabled for this caller. Permanent.
        disabled,
        /// Policy refused it.
        denied(option<string>),
        /// Could not be served now. Retry may succeed.
        unavailable(string),
        /// A failure not captured above.
        other(option<string>),
    }

    /// The catalog entries this caller may use, best match first. With
    /// `query`, only those whose name, summary or tools match it, ignoring
    /// case.
    ///
    /// Read as many offers as needed and drop the stream to stop; the
    /// listing has no cap of its own. The future resolves once the stream
    /// has ended or been dropped, so read or drop the stream before waiting
    /// on it. It is `ok` when every match was sent or the caller stopped
    /// early, and an error when discovery failed. An error before any offer
    /// ends the stream with nothing on it; an error midway ends it after the
    /// offers already sent, which stay valid but are not all the matches.
    @unstable(feature = agent-tool-loading)
    list-offers: async func(query: option<string>) -> tuple<stream<offer>, future<result<_, discovery-error>>>;
}
