package cosmonic:agent@0.4.4;

/// The caller may ask which tool components are available to it. Unstable
/// behind `agent-tool-loading`.
///
/// The implementer keeps the catalog and answers for this caller only,
/// leaving out offers policy would never grant. Asking starts and loads
/// nothing. A `find_tools` tool the implementer offers the model is an
/// adapter over `list-offers`, and exists only where the caller holds this
/// power. Tool names and descriptions are written by tool component authors:
/// treat them as untrusted input to a model.
@unstable(feature = agent-tool-loading)
interface tool-discovery {
    @unstable(feature = agent-tool-loading)
    use tool-types.{tool-def};
    @unstable(feature = agent-tool-loading)
    use tool-component-types.{catalog-name, tool-component-state};

    /// Whether loading an offer would wait on a grantor, as `tool-loading`
    /// would decide it for this caller now. It can change: a person may
    /// approve or remove an entry, and policy may change.
    @unstable(feature = agent-tool-loading)
    variant ceiling-fit {
        /// Loading it needs no grantor.
        within-ceiling,
        /// Loading it waits on a grantor, who could allow it.
        beyond-ceiling,
        /// A relation this version does not name, by its kebab-case name.
        /// Treat it as `beyond-ceiling`.
        other(string),
    }

    /// One catalog entry the caller may load or hand to a child.
    @unstable(feature = agent-tool-loading)
    record offer {
        /// The catalog name, as `tool-component-source.catalog` takes it.
        name: catalog-name,
        /// What it does, from the catalog.
        summary: string,
        /// Its tools under their own names.
        tools: list<tool-def>,
        /// The interfaces its pinned component imports, read from the
        /// binary: it can call nothing else directly. This does not show
        /// where data flows through those interfaces or their configuration.
        imports: list<string>,
        /// Whether loading it would wait on a grantor.
        fit: ceiling-fit,
        /// Its state in the caller's session, if the caller holds it.
        state: option<tool-component-state>,
    }

    /// Why discovery failed. Detail strings are diagnostic: the
    /// implementer's own words, safe to show the caller, never to be parsed.
    @unstable(feature = agent-tool-loading)
    variant discovery-error {
        /// Discovery is not enabled for this caller. Permanent.
        disabled,
        /// Policy refused it.
        denied(option<string>),
        /// Could not be served now. Retry may succeed.
        unavailable(option<string>),
        /// A failure not captured above.
        other(option<string>),
    }

    /// The catalog entries this caller may use, best match first. With
    /// `query`, only those whose name, summary or tools match it, ignoring
    /// case; an empty query is the same as `none`.
    ///
    /// A failure before any offer, such as `disabled` or `denied`, is the
    /// call's own error. Otherwise the call returns a stream of offers and a
    /// future. Read as many offers as needed and drop the stream to stop; the
    /// listing has no cap of its own. The future resolves once the stream has
    /// ended or been dropped, so read or drop the stream before waiting on
    /// it. It is `ok` when every match was sent or the caller stopped early,
    /// and an error when discovery failed midway: the offers already sent
    /// stay valid, but they are not all the matches.
    @unstable(feature = agent-tool-loading)
    list-offers: async func(query: option<string>) -> result<tuple<stream<offer>, future<result<_, discovery-error>>>, discovery-error>;
}
