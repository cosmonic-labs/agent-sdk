/// Inference, authorized model access, tools, and durable agent sessions.
package cosmonic:agent@0.4.4;

/// A provider owns the model resources used by its inference interfaces.
@since(version = 0.3.0)
world inference-provider {
    export inference-types;
    export model-admin;
    export chat;
    export embeddings;
}

/// A trusted serving component, such as an OpenAI-compatible server.
@since(version = 0.3.0)
world inference-client {
    import inference-types;
    import model-admin;
    import chat;
    import embeddings;
}

/// A provider that only serves chat.
@since(version = 0.3.0)
world chat-provider {
    export inference-types;
    export model-admin;
    export chat;
}

/// A provider that only serves embeddings.
@since(version = 0.3.0)
world embeddings-provider {
    export inference-types;
    export model-admin;
    export embeddings;
}

/// A sandboxed agent acquires models through workload-scoped aliases.
/// Model administration, credentials, and network permissions belong to the host.
/// Notifications require an explicit cosmonic:notifications import and provider
/// permission.
@since(version = 0.3.0)
world agent {
    import inference-types;
    import models;
    import chat;
    import tools;
    import session;
}

/// A tool's network and storage permissions belong to its provider component.
@since(version = 0.3.0)
world tool-provider {
    export tools;
}

/// An agent that can be handed runs: the `agent` world plus the `run`
/// export. A host drives it through the export, so it needs no ingress and
/// no protocol of its own. The world a child agent started by another
/// agent targets, too.
@unstable(feature = agent-run)
world runnable-agent {
    include agent;

    export run;
}

/// A runnable agent that can also summarize its context when its driver
/// asks: `runnable-agent` plus the `compact` export. Optional: a driver
/// that finds no `compact` export leaves compaction to the agent.
@unstable(feature = agent-run)
world compactable-agent {
    include runnable-agent;

    export compact;
}

/// The power to drive an agent's runs. Holds only this import. For a
/// component that adapts another protocol onto an agent (an adapter that
/// imports `run` and exports `wasi:http/handler` to serve `POST /task`), or a
/// test double that plays the host.
@unstable(feature = agent-run)
world run-client {
    import run;
}

/// The power to drive an agent's runs and ask it to compact. `run-client`
/// plus the `compact` import, for a driver bound to a `compactable-agent`.
/// Kept apart from `run-client` so a component that only drives runs can
/// still be composed with an agent that does not export `compact`.
@unstable(feature = agent-run)
world compact-client {
    include run-client;

    import compact;
}


/// The power to start child agents and read their final replies. Holds only
/// this import: an agent adds `include agent;` (or `runnable-agent`) itself.
@unstable(feature = agent-spawn)
world spawn-client {
    import spawn;
}

/// The power to ask which toolsets are available. Holds only this import.
@unstable(feature = agent-spawn)
world tool-discovery-client {
    import tool-discovery;
}

/// The power to change one's own toolsets while running. Holds only this
/// import: loading implies neither discovery nor spawning.
@unstable(feature = agent-spawn)
world tool-loading-client {
    import tool-loading;
}

/// A runnable agent with every power in this group: it can find tools,
/// load them into itself, and start child agents. A convenience; an agent
/// that needs fewer powers includes only the client worlds it uses.
@unstable(feature = agent-spawn)
world spawning-agent {
    include runnable-agent;
    include spawn-client;
    include tool-discovery-client;
    include tool-loading-client;
}

/// An implementer of `spawn`, such as a host plugin or a test double.
@unstable(feature = agent-spawn)
world spawn-provider {
    export spawn;
}

/// An implementer of tool discovery.
@unstable(feature = agent-spawn)
world tool-discovery-provider {
    export tool-discovery;
}

/// An implementer of tool loading. It also serves the caller's `tools`
/// import, since a loaded toolset's tools are offered there.
@unstable(feature = agent-spawn)
world tool-loading-provider {
    export tool-loading;
    export tools;
}
